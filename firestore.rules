rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Catalog works & subcollections (likes, comments, chapters)
    match /works/{workId} {
      allow read, write: if true;

      match /chapters/{chapterId} {
        allow read, write: if true;
      }

      match /likes/{uid} {
        allow read, write: if true;
      }

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // User profiles & subcollections
    match /users/{uid} {
      allow read, write: if true;

      match /notifications/{nid} {
        allow read, write: if true;
      }

      match /followers/{followerId} {
        allow read, write: if true;
      }

      match /following/{targetUserId} {
        allow read, write: if true;
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }

      match /reading_progress/{workId} {
        allow read, write: if true;
      }

      match /favorites/{workId} {
        allow read, write: if true;
      }

      match /likes/{workId} {
        allow read, write: if true;
      }
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Top-level collections
    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    match /reading_progress/{workId} {
      allow read, write: if true;
    }

    match /banned_users/{userId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /audits/{auditId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /usernames/{usernameLower} {
      allow read, write: if true;
    }

    match /accounts/{email} {
      allow read, write: if true;
    }
  }
}
