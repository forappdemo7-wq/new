rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default allow read/write for preview/testing to prevent any permission issues
    match /{document=**} {
      allow read, write: if true;
    }

    // Public test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catalog works
    match /works/{workId} {
      allow read, write: if true;

      match /chapters/{chapterId} {
        allow read, write: if true;
      }

      match /likes/{userId} {
        allow read, write: if true;
      }

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // User profiles & subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /notifications/{notificationId} {
        allow read, write: if true;
      }

      match /followers/{followerId} {
        allow read, write: if true;
      }

      match /following/{targetUserId} {
        allow read, write: if true;
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }

      match /reading_progress/{workId} {
        allow read, write: if true;
      }

      match /favorites/{workId} {
        allow read, write: if true;
      }
    }

    // Top-level collections
    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    match /reading_progress/{workId} {
      allow read, write: if true;
    }

    match /banned_users/{userId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /audits/{auditId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /usernames/{usernameLower} {
      allow read, write: if true;
    }

    match /accounts/{email} {
      allow read, write: if true;
    }
  }
}
