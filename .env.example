# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: (Frontend on Vercel)
# The public HTTPS URL of your Render backend (e.g. https://narrative-realm-backend.onrender.com).
# Leave empty if using local dev or Vercel rewrites in vercel.json.
VITE_API_URL=""

# CORS_ORIGIN: (Backend on Render)
# Allowed frontend origins separated by comma (e.g. https://my-app.vercel.app,http://localhost:3000)
# Leave empty or set to * to allow all origins.
CORS_ORIGIN="*"

# ADMIN_PASSWORD:
# Optional administrator master password override.
# If omitted, uses the secure cryptographic curator master credential.
ADMIN_PASSWORD=""

# BACKBLAZE B2 CLOUD STORAGE (Failover Provider):
# Used when Firebase Storage hits quota (5GB free limit) or fails.
# Configure these in your private .env file or hosting environment (Render Dashboard):
B2_KEY_ID="" # Master Key ID or Application Key ID (e.g. your B2 key ID)
B2_APPLICATION_KEY="" # Secret Application Key (generated in Backblaze B2 console)
B2_BUCKET_NAME="" # Backblaze B2 Bucket Name
B2_REGION="us-west-004" # Your bucket region (e.g. us-west-004)
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com" # S3 Endpoint for your bucket
B2_CUSTOM_DOMAIN="" # Optional: Cloudflare CDN domain for 100% free egress


